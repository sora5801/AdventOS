# AdventOS inittab — services started by init at boot.
#
# Format:  <mode> <program> [args...]
#   once    : run once, don't restart on exit
#   respawn : restart whenever this exits (dead-job loop guard)
#
# Lines starting with `#` and blank lines are ignored.

once httpd.elf
once httpsd.elf
once sshd.elf
# Session 64: JSON-RPC tool surface for external agents on loopback.
respawn agentd.elf
once sh.elf selftest
